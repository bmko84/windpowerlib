local godCorner = Instance.new("UICorner", godButton)
godCorner.CornerRadius = UDim.new(0,12)

local function enableGod(character)
	if not character then return end
	local hum = character:FindFirstChildWhichIsA("Humanoid") or character:WaitForChild("Humanoid",5)
	if not hum then return end
	hum.MaxHealth = 1e6
	hum.Health = hum.MaxHealth
	local conn
	conn = hum.HealthChanged:Connect(function()
		if not hum or not hum.Parent then
			if conn then pcall(function() conn:Disconnect() end) end
			return
		end
		if godEnabled and hum.Health < hum.MaxHealth then
			hum.Health = hum.MaxHealth
		end
	end)
end

godButton.MouseButton1Click:Connect(function()
	godEnabled = not godEnabled
	if godEnabled then
		godButton.Text = "GodMode: ✓"
		if LocalPlayer.Character then
			enableGod(LocalPlayer.Character)
		end
	else
		godButton.Text = "GodMode: ◌"
	end
end)

if LocalPlayer.Character then
	enableGod(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(enableGod)

