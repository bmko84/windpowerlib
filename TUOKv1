-- NameTag Button
--==============================
local nameTags = {}
local nameTagEnabled = true
local nameTagButton = Instance.new("TextButton")
nameTagButton.Parent = mainFrame
nameTagButton.Position = UDim2.new(0.35,0,0.35,0)
