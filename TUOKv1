local nameTagCorner = Instance.new("UICorner", nameTagButton)
nameTagCorner.CornerRadius = UDim.new(0,12)

-- NameTag function
local function addNameTag(character, player)
	if character:FindFirstChild("Head") then
		local head = character.Head
		local billboard = Instance.new("BillboardGui")
		billboard.Adornee = head
		billboard.Size = UDim2.new(0,200,0,50)
		billboard.StudsOffset = Vector3.new(0,2,0)
		billboard.AlwaysOnTop = true
		billboard.Name = "VD_NameTag"
		billboard.Parent = head

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Text = player.Name
		nameLabel.Size = UDim2.new(1,0,1,0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.TextColor3 = Color3.new(1,1,1)
		nameLabel.TextStrokeTransparency = 0
		nameLabel.TextScaled = true
		nameLabel.Font = Enum.Font.SourceSansBold
		nameLabel.Parent = billboard

		nameTags[player] = billboard
	end
end

local function onCharacterAdded(character, player)
	addNameTag(character, player)
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(char, player)
	end)
end

for _, player in pairs(Players:GetPlayers()) do
	if player.Character then
		addNameTag(player.Character, player)
	end
	onPlayerAdded(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)

nameTagButton.MouseButton1Click:Connect(function()
	nameTagEnabled = not nameTagEnabled
	for player, tag in pairs(nameTags) do
		if tag then
			tag.Enabled = nameTagEnabled
		end
	end
	if nameTagEnabled then
		nameTagButton.Text = "NameTag: ✓"
	else
		nameTagButton.Text = "NameTag: ◌"
	end
end)

