local hitboxButton = Instance.new("TextButton")
hitboxButton.Parent = mainFrame
hitboxButton.Size = UDim2.new(0.2,0,0,30)
hitboxButton.Position = UDim2.new(0.3,0,0.65,0)
hitboxButton.Text = "Enable Hitbox"
hitboxButton.BackgroundColor3 = Color3.fromRGB(50,50,50)
hitboxButton.TextColor3 = Color3.new(1,1,1)
local hitboxCorner = Instance.new("UICorner", hitboxButton)
hitboxCorner.CornerRadius = UDim.new(0,8)

local hitboxPlayers = {}

local function updateHitbox()
    if not hitboxEnabled then return end
    hitboxPlayers = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(hitboxPlayers,p)
        end
    end
end

hitboxButton.MouseButton1Click:Connect(function()
    hitboxEnabled = not hitboxEnabled
    hitboxButton.Text = hitboxEnabled and "Disable Hitbox" or "Enable Hitbox"
    updateHitbox()
end)

